{
  "expo": {
    "name": "GravityDesk",
    "slug": "gravitydesk",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0d1117"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.gravitydesk.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0d1117"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.INTERNET"
      ]
    }
  }
}
